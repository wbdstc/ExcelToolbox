<?xml version="1.0" encoding="utf-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="RibbonOnLoad">
  <ribbon>
    <tabs>
      <tab id="tabExcelToolbox" label="ExcelToolbox" insertAfterMso="TabHome">
        
        <!-- 导出与批处理工具组 -->
        <group id="grpExport" label="批处理工具">
          <splitButton id="splitExportPdf" size="large">
            <button id="btnExportPdf"
                    label="导出为 PDF"
                    imageMso="FileSaveAsPdfOrXps"
                    onAction="OnRibbonAction"
                    tag="ExportPdf"
                    screentip="导出为 PDF"
                    supertip="打开 PDF 导出面板，支持选择导出指定工作表、当前工作表、合并导出或分别导出独立 PDF。" />
            <menu id="mnuExportPdf">
              <button id="btnExportSinglePdf"
                      label="导出指定工作表为 PDF..."
                      imageMso="FileSaveAsPdfOrXps"
                      onAction="OnRibbonAction"
                      tag="ExportPdfSingle"
                      screentip="导出指定工作表为 PDF"
                      supertip="从工作簿中自由选择具体某一个工作表导出为独立的 PDF 文件。" />
              <button id="btnExportActivePdf"
                      label="导出当前工作表为 PDF"
                      imageMso="FileSaveAsPdfOrXps"
                      onAction="OnRibbonAction"
                      tag="ExportPdfActive"
                      screentip="导出当前工作表为 PDF"
                      supertip="直接将当前活动的工作表快速导出为独立的 PDF 文件。" />
              <menuSeparator id="sepExportPdf" />
              <button id="btnExportMergedPdf"
                      label="合并所有可见 Sheet 导出为单个 PDF"
                      imageMso="FileSaveAsPdfOrXps"
                      onAction="OnRibbonAction"
                      tag="ExportPdfMerged"
                      screentip="合并所有可见工作表为单个 PDF"
                      supertip="将当前工作簿中所有可见工作表合并导出为一个完整的 PDF 文件。" />
              <button id="btnExportSeparatePdf"
                      label="各可见 Sheet 分别导出为独立 PDF"
                      imageMso="FileSaveAsPdfOrXps"
                      onAction="OnRibbonAction"
                      tag="ExportPdfSeparate"
                      screentip="各可见工作表分别导出为独立 PDF"
                      supertip="将当前工作簿中每个可见工作表分别导出为独立的 PDF 文件。" />
            </menu>
          </splitButton>
        </group>

        <!-- 视图与辅助工具组 -->
        <group id="grpViewEnhance" label="视图辅助">
          <toggleButton id="btnToggleCrosshair"
                        label="十字聚光灯"
                        size="large"
                        imageMso="ReviewHighlightChanges"
                        onAction="OnRibbonToggleAction"
                        getPressed="GetRibbonPressed"
                        tag="ToggleCrosshair"
                        screentip="十字聚光灯行列高亮"
                        supertip="开启或关闭当前活动单元格所在行和列的聚光灯高亮显示。" />
          
          <toggleButton id="btnToggleDoubleClick"
                        label="双击打勾"
                        size="large"
                        imageMso="AcceptInvitation"
                        onAction="OnRibbonToggleAction"
                        getPressed="GetRibbonPressed"
                        tag="ToggleDoubleClick"
                        screentip="双击快速填充√"
                        supertip="开启后，双击单元格可快速填入或清除'√'标记，并自动拦截进入编辑状态。" />
        </group>

        <!-- 关于与设置组 -->
        <group id="grpAbout" label="关于">
          <button id="btnAbout"
                  label="关于工具箱"
                  size="normal"
                  imageMso="Info"
                  onAction="OnRibbonAction"
                  tag="About"
                  screentip="关于 ExcelToolbox"
                  supertip="查看 ExcelToolbox 版本信息与说明。" />
        </group>

      </tab>
    </tabs>
  </ribbon>
</customUI>
